rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can create/update only their own profile; any logged-in user can read profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Any logged-in user can read products; only the uploader can create/change/delete theirs.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.uploaderId == request.auth.uid;
    }
  }
}
